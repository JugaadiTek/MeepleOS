<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hideous Abomination</title>
</head>
<body>
  <section class="nav">
    <nav>
      <div class="logo">
        <a href="/"><img src="/src/assets/logo.png" alt="MeepleOS Logo" /></a>
      </div>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/games/">Games</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
      <div class="socials">
        <a href="https://twitter.com/meepleos" target="_blank" rel="noopener noreferrer">Twitter</a>
        <a href="https://www.facebook.com/meepleos" target="_blank" rel="noopener noreferrer">Facebook</a>
      </div>
    </nav>
  </section>
  <section class="main-content">
    <h1>Hideous Abomination</h1>
    <p>by <a href="https://www.boardgamegeek.com/boardgame/353694/hideous-abomination">BoardGameGeek</a></p>
    <div class="container">
      <div class="inner-container">
        <div class="setup">
          <h2>Game Setup</h2>
        </div>
        <div class="turn">
          <h2>Player Turn</h2>
          <ol>
            <li>
              <span>Roll The Dice</span>
            </li>
            <li>
              <span>Perform Action</span>
              <ul>
                <li><b>Draw:</b> One Card from any pile TWICE.</li>
                <li><b>Reveal:</b> an award tile, then do the draw action.</li>
                <li><b>Dig:</b> Pick any two tiles from a single discard pile.</li>
                <li><b>Steal:</b>
                  <ol>
                    <li>Take any one tile from another players body.<br/> <i>(The starting tile and any bolted tiles cannot be stolen)</i></li>
                    <li>Give 2 Bolts to the player whose tile was stolen.</li>
                  </ol>
                </li>
                <li><b>Go Mad:</b> Do any action from above.</li>
              </ul>
            </li>
            <li>Play a Tile on any player's body.</li>
            <li>Discard down to 3 cards.</li>
          </ol>
        </div>
        <div class="player-reference">
          <h2>Player Reference</h2>
          <ul>
            <li><b>Bolts:</b> must be played immediately if able.</li>
          </ul>
        </div>
        <div class="game-reference">
          <h2>Game Reference</h2>
        </div>
        <div class="score-helper">
          <h2>Score Helper</h2>
        </div>
        <div class="appendex">
          <h2>Appendex</h2>
        </div>
      </div>
    </div>
  </section>
  <section class="footer">
    <p>© 2024 MeepleOS. All rights reserved.</p>
  </section>
</body>
</html>

<style>
  :root {
    --c00: #ffb703;
    --c01: #B5BA72;
    --c02: #fb8500;
    --c03: #7D6F86;
    --c04: #585191;
    --c05: #4F359B;
    --c06: #219ebc;
    --c07: #023047;
  }
  html, body {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    background-color: var(--c01);
    color: var(--c02);
  }
  body {
    background-color: var(--c07);
    color: var(--c00);
  }

  .logo img {
    height: 80px;
  }
  p {
    color: var(--c01);
  }
  a, a:visited {
    color: var(--c02);
  }
  b {
    color: var(--c02);
    font-weight: 800;
    text-transform: uppercase;
  }
  i {
    color: var(--c03);
    font-style: italic;
    font-weight: 100;
  }
  .nav {
    background: var(--c05);
    padding: 10px;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer {
    background: var(--c06);
    min-height: 300px;
  }
</style>